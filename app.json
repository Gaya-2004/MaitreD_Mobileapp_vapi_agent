{
  "expo": {
    "name": "MaitreD",
    "slug": "maitred-app",
    "owner": "gayatrik",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maitred",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/images/icon.png",
      "config": {
        "googleMapsApiKey": "AIzaSyA2qxAJag8F89Q_TdtjqU_42W6JAVJ5_qg"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Allow MaitreD to access your microphone for the voice assistant.",
        "NSCameraUsageDescription": "Allow MaitreD to access your camera to scan table QR codes.",
        "NSLocationWhenInUseUsageDescription": "Allow MaitreD to use your location to find nearby addresses.",
        "NSPhotoLibraryUsageDescription": "Allow MaitreD to access your photos for profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.maitred.app",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA2qxAJag8F89Q_TdtjqU_42W6JAVJ5_qg"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.maitred.app",
      "versionCode": 3
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MaitreD to access your camera to scan table QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MaitreD to access your photos for profile pictures.",
          "cameraPermission": "Allow MaitreD to access your camera to take profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MaitreD to use your location to find nearby addresses."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24,
            "newArchEnabled": false
          },
          "ios": {
            "deploymentTarget": "16.4",
            "newArchEnabled": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "798b128a-6b30-4f91-a308-969031c13b71"
      }
    }
  }
}

